# OpenSky Production Environment Variables
# Copy to .env for local runtime configuration

# Port for local development server
PORT=3000

# Node Environment ('development', 'production', 'test')
NODE_ENV=production

# GenAI Smog Advisor API Key (Google AI Studio)
# Keep strictly confidential. In client-side builds, requests route via rate-limited backend.
GEMINI_API_KEY=your_gemini_api_key_here

# Real-time CPCB / OpenAQ Station API Base URL
AQI_API_BASE_URL=https://api.openaq.org/v2

# Rate Limit Config (Max requests per window per IP)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
