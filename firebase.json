{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "scratch/**",
      "node_modules/**",
      "dist/**",
      "server/**",
      "docs/**",
      "*.png",
      "*.zip",
      "package*.json",
      "tsconfig.json",
      "eslint.config.js",
      "tests/**"
    ],
    "headers": [
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
