{
  "name": "opensky",
  "version": "1.0.0",
  "description": "OpenSky Smog Safety & Community Air Resilience Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "smog-safety",
    "genai",
    "air-quality",
    "community-shield",
    "wcag22"
  ],
  "author": "Vyshu Kandikanti",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^3.24.2"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
